// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  EMPLOYEE
}

enum ProductUnit {
  PCS
  PORSI
  GELAS
  PAKET
  LAINNYA
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum SaleStatus {
  ACTIVE
  VOID
}

enum ExpenseCategory {
  MATERIAL_PURCHASE
  OPERATING
  OWNER_WITHDRAWAL
  OTHER
}

enum DailyCashStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
}

enum VoidRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockMovementType {
  OPENING
  IN
  OUT
  ADJUSTMENT
  SALE
  VOID
}

model User {
  id                 String   @id @default(cuid())
  name               String
  username           String   @unique
  email              String   @unique
  emailVerified      Boolean  @default(false)
  displayUsername    String?
  image              String?
  passwordHash       String?
  mustChangePassword Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]
  sessions    Session[]
  accounts    Account[]
}

model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  outlets     Outlet[]
  categories  Category[]
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  businessId String
  role       MembershipRole
  pinHash    String?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  outletAssignments OutletAssignment[]
  productsCreated   Product[]           @relation("ProductCreatedBy")
  hppChanges        ProductHppHistory[]
  sales             Sale[]              @relation("SaleCashier")
  expenses          Expense[]
  cashMovements     CashMovement[]
  openedCashDays    DailyCash[]         @relation("CashOpenedBy")
  closedCashDays    DailyCash[]         @relation("CashClosedBy")
  voidRequests      VoidRequest[]       @relation("VoidRequestedBy")
  voidDecisions     VoidRequest[]       @relation("VoidApprovedBy")
  cashierSessions   CashierSession[]

  @@unique([userId, businessId])
  @@index([businessId, role, isActive])
}

model Outlet {
  id         String   @id @default(cuid())
  businessId String
  name       String
  code       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  assignments   OutletAssignment[]
  products      Product[]
  sales         Sale[]
  expenses      Expense[]
  dailyCashDays DailyCash[]
  cashMovements CashMovement[]
  voidRequests  VoidRequest[]
  inventories   Inventory[]

  @@unique([businessId, name])
  @@unique([businessId, code])
  @@unique([businessId, id])
  @@index([businessId, isActive])
}

model OutletAssignment {
  id           String   @id @default(cuid())
  membershipId String
  outletId     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  outlet     Outlet     @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@unique([membershipId, outletId])
  @@index([outletId, isActive])
}

model Product {
  id           String      @id @default(cuid())
  businessId   String
  outletId     String
  createdById  String?
  name         String
  unit         ProductUnit @default(PCS)
  sellingPrice Decimal     @db.Decimal(14, 2)
  hpp          Decimal?    @db.Decimal(14, 2)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  categoryId   String?

  outlet    Outlet      @relation(fields: [businessId, outletId], references: [businessId, id], onDelete: Restrict)
  createdBy Membership? @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  category  Category?   @relation(fields: [businessId, categoryId], references: [businessId, id], onDelete: Restrict)

  hppHistory  ProductHppHistory[]
  saleItems   SaleItem[]
  inventories Inventory[]

  @@unique([outletId, name])
  @@unique([businessId, outletId, id])
  @@index([businessId, outletId, isActive])
}

model ProductHppHistory {
  id          String   @id @default(cuid())
  businessId  String
  outletId    String
  productId   String
  changedById String?
  oldHpp      Decimal? @db.Decimal(14, 2)
  newHpp      Decimal? @db.Decimal(14, 2)
  changedAt   DateTime @default(now())
  note        String?

  product   Product     @relation(fields: [businessId, outletId, productId], references: [businessId, outletId, id], onDelete: Restrict)
  changedBy Membership? @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([productId, changedAt])
}

model Sale {
  id                String        @id @default(cuid())
  businessId        String
  outletId          String
  dailyCashId       String
  cashierId         String
  transactionNumber String
  idempotencyKey    String
  paymentMethod     PaymentMethod
  totalAmount       Decimal       @db.Decimal(14, 2)
  status            SaleStatus    @default(ACTIVE)
  soldAt            DateTime      @default(now())
  voidedAt          DateTime?
  createdAt         DateTime      @default(now())

  outlet      Outlet       @relation(fields: [businessId, outletId], references: [businessId, id], onDelete: Restrict)
  dailyCash   DailyCash    @relation(fields: [businessId, outletId, dailyCashId], references: [businessId, outletId, id], onDelete: Restrict)
  cashier     Membership   @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: Restrict)
  items       SaleItem[]
  voidRequest VoidRequest?

  @@unique([outletId, transactionNumber])
  @@unique([outletId, idempotencyKey])
  @@unique([businessId, outletId, id])
  @@index([businessId, outletId, soldAt, status])
  @@index([dailyCashId, status])
}

model SaleItem {
  id                  String   @id @default(cuid())
  saleId              String
  productId           String
  productNameSnapshot String
  quantity            Decimal  @db.Decimal(12, 3)
  unitPrice           Decimal  @db.Decimal(14, 2)
  hppSnapshot         Decimal? @db.Decimal(14, 2)
  lineTotal           Decimal  @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model Expense {
  id            String          @id @default(cuid())
  businessId    String
  outletId      String
  dailyCashId   String?
  recordedById  String
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(14, 2)
  paymentMethod PaymentMethod
  description   String?
  expenseAt     DateTime        @default(now())
  createdAt     DateTime        @default(now())

  outlet     Outlet      @relation(fields: [businessId, outletId], references: [businessId, id], onDelete: Restrict)
  dailyCash  DailyCash?  @relation(fields: [businessId, outletId, dailyCashId], references: [businessId, outletId, id], onDelete: Restrict)
  recordedBy Membership  @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([businessId, outletId, expenseAt])
  @@index([businessId, outletId, category, expenseAt])
  @@index([dailyCashId])
}
model DailyCash {
  id                     String          @id @default(cuid())
  businessId             String
  outletId               String
  operationalDate        DateTime        @db.Date
  openingBalance         Decimal         @db.Decimal(14, 2)
  expectedClosingBalance Decimal?        @db.Decimal(14, 2)
  actualClosingBalance   Decimal?        @db.Decimal(14, 2)
  status                 DailyCashStatus @default(OPEN)
  openedById             String
  closedById             String?
  openedAt               DateTime        @default(now())
  closedAt               DateTime?

  outlet    Outlet         @relation(fields: [businessId, outletId], references: [businessId, id], onDelete: Restrict)
  openedBy  Membership     @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy  Membership?    @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  sales     Sale[]
  movements CashMovement[]
  expenses  Expense[]

  @@unique([outletId, operationalDate])
  @@unique([businessId, outletId, id])
  @@index([businessId, outletId, operationalDate, status])
}

model CashMovement {
  id           String           @id @default(cuid())
  businessId   String
  outletId     String
  dailyCashId  String
  recordedById String
  type         CashMovementType
  category     String
  amount       Decimal          @db.Decimal(14, 2)
  description  String?
  createdAt    DateTime         @default(now())

  outlet     Outlet     @relation(fields: [businessId, outletId], references: [businessId, id], onDelete: Restrict)
  dailyCash  DailyCash  @relation(fields: [businessId, outletId, dailyCashId], references: [businessId, outletId, id], onDelete: Restrict)
  recordedBy Membership @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([dailyCashId, createdAt])
}

model VoidRequest {
  id            String            @id @default(cuid())
  businessId    String
  outletId      String
  saleId        String
  requestedById String
  approvedById  String?
  reason        String
  status        VoidRequestStatus @default(PENDING)
  requestedAt   DateTime          @default(now())
  decidedAt     DateTime?

  outlet      Outlet      @relation(fields: [businessId, outletId], references: [businessId, id], onDelete: Restrict)
  sale        Sale        @relation(fields: [businessId, outletId, saleId], references: [businessId, outletId, id], onDelete: Restrict)
  requestedBy Membership  @relation("VoidRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  Membership? @relation("VoidApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([businessId, outletId, saleId])
  @@index([businessId, outletId, status, requestedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  businessId  String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  beforeData  Json?
  afterData   Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([businessId, name])
  @@unique([businessId, id])
  @@index([businessId, isActive])
}

model Inventory {
  id         String   @id @default(cuid())
  businessId String
  outletId   String
  productId  String
  quantity   Decimal  @default(0) @db.Decimal(14, 3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outlet  Outlet  @relation(fields: [businessId, outletId], references: [businessId, id], onDelete: Restrict)
  product Product @relation(fields: [businessId, outletId, productId], references: [businessId, outletId, id], onDelete: Restrict)

  movements StockMovement[]

  @@unique([businessId, outletId, productId])
  @@index([businessId, outletId])
}

model StockMovement {
  id          String            @id @default(cuid())
  inventoryId String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(14, 3)
  note        String?
  referenceId String?
  createdAt   DateTime          @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([inventoryId, createdAt])
}

model CashierSession {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  membershipId String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId, expiresAt])
}
